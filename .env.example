# Local origin. Set the final HTTPS website origin in Vercel for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project access. Fill local/deployment settings; never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy key aliases remain supported for the colleague's existing project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Optional enquiry email alerts. Enquiries remain stored when these are absent.
# Use a verified sender domain; credentials alone do not verify a sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_EMAIL=

# On-demand ISR cache revalidation secret
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
REVALIDATION_TOKEN=

# Generate another independent random token for the protected retry job.
CRON_SECRET=

# Anonymous reference files: 3 MB each, with this site-wide daily upload budget.
ENQUIRY_ATTACHMENT_DAILY_LIMIT=10
