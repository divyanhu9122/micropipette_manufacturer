# Public site URL
NEXT_PUBLIC_SITE_URL=https://www.micropipettemanufacturer.in

# Supabase — get these from supabase.com > your project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_KEY=your-service-role-secret-key-here

# Email notifications — get from resend.com (free tier)
RESEND_API_KEY=re_your_key_here
NOTIFICATION_EMAIL=sales@micropipettemanufacturer.in

# On-demand ISR cache revalidation secret
REVALIDATION_TOKEN=generate-a-random-string-here
